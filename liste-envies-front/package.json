{
  "name": "liste-envies-front",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prettier": "prettier --write \"**/*.{js,json,css,md,ts,html,component.html}\" !**/documentation/**",
    "precommit": "lint-staged",
    "start": "ng serve --proxy-config proxy-config.local.json",
    "serve": "ng serve --proxy-config proxy-config.dist.json --port 4242",
    "serve-prod": "ng serve --proxy-config proxy-config.dist.json --port 4240 --configuration production",
    "ce": "ng serve --proxy-config proxy-config.dist.json --host 0.0.0.0 --port 8003 --disable-host-check",
    "build": "ng build",
    "build-prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "compodoc": "./node_modules/.bin/compodoc -p src/tsconfig.app.json",
    "hmr": "ng serve --hmr --proxy-config proxy-config.dist.json --host 0.0.0.0 --port 8004 --disable-host-check"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.2",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^21.1.2",
    "@angular/compiler": "^21.1.2",
    "@angular/core": "^21.1.2",
    "@angular/fire": "19",
    "@angular/forms": "^21.1.2",
    "@angular/material": "^19.2.19",
    "@angular/material-moment-adapter": "^19.2.19",
    "@angular/platform-browser": "^21.1.2",
    "@angular/platform-browser-dynamic": "^21.1.2",
    "@angular/router": "^21.1.2",
    "@datorama/akita": "^5.2.3",
    "@datorama/akita-ng-forms-manager": "^5.0.2",
    "@firebase/app": "0.10.17",
    "@firebase/util": "1.10.2",
    "@ngneat/until-destroy": "^10.0.0",
    "akita-filters-plugin": "^4.0.0",
    "core-js": "^3.38.1",
    "filepond": "^4.31.3",
    "filepond-plugin-file-encode": "^2.1.14",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-resize": "^2.0.10",
    "filepond-plugin-image-transform": "^3.8.7",
    "firebase": "^10.13.0",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "lodash-decorators": "^6.0.1",
    "moment": "^2.30.1",
    "ng-animate": "^0.3.4",
    "ngx-filepond": "^7.0.3",
    "ngx-moment": "^6.0.2",
    "ngx-quill": "^25.3.1",
    "node-vibrant": "^3.2.1-alpha.1",
    "quill": "^2.0.2",
    "rxjs": "^7.8.1",
    "tinycolor2": "^1.4.1",
    "tslib": "^2.0.1",
    "wire.css": "^1.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.2",
    "@angular/language-service": "^21.1.2",
    "@angularclass/hmr": "^3.0.0",
    "@compodoc/compodoc": "^1.1.11",
    "@schuchard/prettier": "^3.1.0",
    "@types/node": "^12.11.1",
    "akita-schematics": "^2.0.1",
    "husky": "4.3.0",
    "lint-staged": "10.4.0",
    "prettier": "2.1.2",
    "pretty-quick": "^3.0.2",
    "sass": "^1.32.0",
    "ts-node": "~9.0.0",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{js,json,css,md,ts,html,component.html}": [
      "prettier --write",
      "git add"
    ]
  }
}
